# PostgreSQL connection string (Neon or any PostgreSQL database).
# The app runtime uses this URL. Prisma "migrate" commands can fail over a
# Neon POOLED (-pooler) URL; run migrations with the direct (non-pooled)
# URL temporarily, or adopt a DATABASE_URL/DIRECT_URL split (see README).
DATABASE_URL=

# Secret used to sign session JWTs. Generate one with either:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
